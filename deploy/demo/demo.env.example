# FinWatch public demo configuration.
#
# Copy to deploy/demo/demo.env (git-ignored) and fill in every value.
# All data in the demo is synthetic.

# Public hostname pointing (DNS A/AAAA record) at the demo host.
DEMO_DOMAIN=finwatch-demo.example.com

# Database credentials: internal to the host, never published.
# Generate with: openssl rand -hex 24
POSTGRES_USER=finwatch
POSTGRES_PASSWORD=
POSTGRES_DB=finwatch

# JWT signing secret: a fresh random value per deployment, at least 32 chars.
# The API refuses the published development example value outside development.
# Generate with: openssl rand -hex 32
JWT_SIGNING_SECRET=
JWT_ACCESS_TOKEN_TTL=15m

# Demo login passwords (operator@example.com / admin@example.com). These are
# shown to visitors so they can try the app; use throwaway values that are not
# reused anywhere else.
DEMO_OPERATOR_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Number of synthetic transactions ingested on first start.
DEMO_SEED_COUNT=200
